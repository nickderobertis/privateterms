{
  "description": "Matching: normalization, case, word characters and the three modes (Specification 1, Matching).",
  "cases": [
    {
      "id": "substring-anywhere",
      "exercises": [
        "MATCH-SUBSTRING",
        "OUT-DETECT"
      ],
      "description": "A substring rule is found anywhere, inside words included.",
      "operation": "detect",
      "rules": [
        {
          "term": "quillmoss",
          "mode": "substring",
          "case_sensitive": false
        }
      ],
      "text": "xquillmossy",
      "expect": {
        "outcome": "detected",
        "found": [
          "quillmoss"
        ],
        "hits": [
          {
            "term": "quillmoss",
            "span": [
              1,
              10
            ],
            "text": "quillmoss"
          }
        ]
      }
    },
    {
      "id": "substring-every-occurrence",
      "exercises": [
        "MATCH-SUBSTRING",
        "MATCH-HITS"
      ],
      "description": "Every occurrence is a hit, in order.",
      "operation": "detect",
      "rules": [
        {
          "term": "quillmoss",
          "mode": "substring",
          "case_sensitive": false
        }
      ],
      "text": "quillmoss and quillmoss",
      "expect": {
        "outcome": "detected",
        "found": [
          "quillmoss"
        ],
        "hits": [
          {
            "term": "quillmoss",
            "span": [
              0,
              9
            ],
            "text": "quillmoss"
          },
          {
            "term": "quillmoss",
            "span": [
              14,
              23
            ],
            "text": "quillmoss"
          }
        ]
      }
    },
    {
      "id": "substring-overlapping-occurrences",
      "exercises": [
        "MATCH-SUBSTRING",
        "MATCH-HITS"
      ],
      "description": "Overlapping occurrences of one term are each a hit.",
      "operation": "detect",
      "rules": [
        {
          "term": "aba",
          "mode": "substring",
          "case_sensitive": false
        }
      ],
      "text": "ababa",
      "expect": {
        "outcome": "detected",
        "found": [
          "aba"
        ],
        "hits": [
          {
            "term": "aba",
            "span": [
              0,
              3
            ],
            "text": "aba"
          },
          {
            "term": "aba",
            "span": [
              2,
              5
            ],
            "text": "aba"
          }
        ]
      }
    },
    {
      "id": "substring-absent",
      "exercises": [
        "MATCH-SUBSTRING",
        "OUT-DETECT"
      ],
      "description": "A text without the term is clean.",
      "operation": "detect",
