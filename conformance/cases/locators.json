          "declaration": {
            "schema_version": 2,
            "phrases": [
              "quillmoss-bridge"
            ]
          }
        }
      ],
      "locators": [
        {
          "kind": "source",
          "value": "quillmoss-bridge"
        }
      ],
      "rules": [
        {
          "term": "quillmoss",
          "mode": "whole-word",
          "case_sensitive": false
        },
        {
          "term": "hiddenco/quillmoss",
          "mode": "owner-name-only",
          "case_sensitive": false
        }
      ],
      "expect": {
        "outcome": "screened",
        "locators": [
          "quillmoss-bridge"
        ],
        "unfixable": false
      }
    },
    {
      "id": "replaceable-term-still-redacted",
      "exercises": [
        "LOC-NOT-REWRITTEN"
      ],
      "description": "A locator carrying a term a replacement is declared for is still redacted, never rewritten.",
      "operation": "screen-locators",
      "levels": [
        {
          "kind": "directory",
          "declaration": {
            "schema_version": 2,
            "replacements": [
              {
                "term": "quillmoss",
                "with": "example"
              }
            ]
          }
        }
      ],
      "locators": [
        {
          "kind": "path",
          "value": "quillmoss/notes.md"
        }
      ],
      "rules": [
        {
          "term": "quillmoss",
          "mode": "whole-word",
          "case_sensitive": false
        },
        {
          "term": "hiddenco/quillmoss",
          "mode": "owner-name-only",
          "case_sensitive": false
        }
      ],
      "expect": {
        "outcome": "screened",
        "locators": [
          {
            "redacted": true,
            "kind": "path",
            "ordinal": 1
          }
        ],
        "unfixable": true,
        "reason": "identifier carries a private term"
      }
    },
    {
      "id": "caller-replacement-still-redacted",
