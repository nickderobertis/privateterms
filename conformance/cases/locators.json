      "locators": [
        {
          "kind": "item",
          "value": "ITEM-42"
        },
        {
          "kind": "path",
          "value": "README.md"
        },
        {
          "kind": "identity",
          "value": "hiddenco/quillmoss"
        }
      ],
      "rules": [
        {
          "term": "quillmoss",
          "mode": "whole-word",
