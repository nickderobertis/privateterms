        {
          "kind": "identity",
          "value": "hiddenco/quillmoss.git"
        },
        {
          "kind": "identity",
          "value": "hiddenco/quillmoss-site"
        }
      ],
      "rules": [
        {
          "term": "hiddenco/quillmoss",
          "mode": "owner-name-only",
          "case_sensitive": false
        }
      ],
      "expect": {
        "outcome": "screened",
        "locators": [
          {
            "redacted": true,
            "kind": "identity",
            "ordinal": 1
          },
          "hiddenco/quillmoss-site"
        ],
        "unfixable": true
      }
    },
    {
      "id": "nfkc-and-zero-width-locators",
      "exercises": [
        "LOC-SCREEN",
        "MATCH-NORMALIZE"
      ],
      "description": "A full-width or zero-width spelling in a locator is matched as in text.",
      "operation": "screen-locators",
      "levels": [],
      "locators": [
        {
          "kind": "field",
          "value": "\uff31\uff55\uff49\uff4c\uff4c\uff4d\uff4f\uff53\uff53"
        },
        {
          "kind": "comment",
          "value": "quill\u200bmoss"
        }
      ],
      "rules": [
        {
          "term": "quillmoss",
          "mode": "whole-word",
          "case_sensitive": false
        },
        {
          "term": "hiddenco/quillmoss",
          "mode": "owner-name-only",
          "case_sensitive": false
        }
      ],
      "expect": {
        "outcome": "screened",
        "locators": [
          {
            "redacted": true,
            "kind": "field",
            "ordinal": 1
          },
          {
            "redacted": true,
            "kind": "comment",
            "ordinal": 2
          }
        ],
        "unfixable": true
      }
    },
    {
      "id": "phrase-exempt-locator-passes",
      "exercises": [
        "LOC-SCREEN",
        "MATCH-PHRASE-EXEMPT"
      ],
      "description": "A locator whose only hit a public phrase exempts passes verbatim.",
      "operation": "screen-locators",
      "levels": [
