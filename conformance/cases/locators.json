        "outcome": "screened",
        "locators": [
          {
            "redacted": true,
            "kind": "item",
            "ordinal": 1
          }
        ],
        "unfixable": true
      }
    },
    {
      "id": "unavailable-redacts-every-locator",
      "exercises": [
        "LOC-UNAVAILABLE",
