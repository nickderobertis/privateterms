{
  "description": "The declaration's members and every invalid form (Specification 1, The declaration).",
  "cases": [
    {
      "id": "version-1-minimal",
      "exercises": [
        "DECL-VERSION"
      ],
      "description": "A version-1 declaration with no other member is valid.",
      "operation": "validate",
      "levels": [
        {
          "kind": "repository",
          "declaration": {
            "schema_version": 1
          }
        }
      ],
      "expect": {
        "outcome": "valid"
      }
    },
    {
      "id": "version-1-all-members",
      "exercises": [
        "DECL-VERSION",
        "DECL-TERMS",
        "DECL-EXCEPTIONS"
      ],
      "description": "Version 1 carries terms and exceptions.",
      "operation": "validate",
      "levels": [
        {
          "kind": "repository",
          "declaration": {
            "schema_version": 1,
            "terms": [
              "quillmoss",
              "vantorel"
            ],
            "exceptions": [
              {
                "term": "quillmoss",
                "action": "drop"
              },
              {
                "term": "vantorel",
                "action": "whole-word"
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "valid"
      }
    },
    {
      "id": "version-1-every-exception-action",
      "exercises": [
        "DECL-EXCEPTIONS"
      ],
      "description": "Each of the four exception actions is valid.",
      "operation": "validate",
      "levels": [
        {
          "kind": "repository",
          "declaration": {
            "schema_version": 1,
            "terms": [
              "a1",
              "b1",
              "c1",
              "d1"
            ],
            "exceptions": [
              {
                "term": "a1",
                "action": "drop"
              },
              {
                "term": "b1",
                "action": "whole-word"
              },
              {
                "term": "c1",
                "action": "case-sensitive"
              },
              {
                "term": "d1",
                "action": "owner-name-only"
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "valid"
      }
    },
    {
      "id": "version-2-all-members",
      "exercises": [
        "DECL-VERSION",
        "DECL-REPLACEMENTS",
        "DECL-PHRASES"
      ],
      "description": "Version 2 adds replacements and phrases.",
      "operation": "validate",
      "levels": [
        {
          "kind": "repository",
          "declaration": {
            "schema_version": 2,
            "terms": [
              "quillmoss"
            ],
            "exceptions": [
              {
                "term": "quillmoss",
                "action": "case-sensitive"
              }
            ],
            "replacements": [
              {
                "term": "quillmoss",
                "with": "example"
              },
              {
                "term": "vantorel",
                "reject": true
              }
            ],
            "phrases": [
              "quillmoss-bridge"
            ]
          }
        }
      ],
      "expect": {
        "outcome": "valid"
      }
    },
    {
      "id": "version-2-directory-level",
      "exercises": [
        "DECL-VERSION",
        "DECL-REPLACEMENTS",
        "DECL-PHRASES"
      ],
      "description": "A directory level may declare terms, replacements and phrases.",
      "operation": "validate",
      "levels": [
        {
          "kind": "directory",
          "declaration": {
            "schema_version": 2,
            "terms": [
              "ostrevane"
            ],
            "replacements": [
              {
                "term": "ostrevane",
                "with": "sample"
              }
            ],
            "phrases": [
              "ostrevane bay"
            ]
          }
        }
      ],
      "expect": {
        "outcome": "valid"
      }
    },
    {
      "id": "version-2-fallback-level",
      "exercises": [
        "DECL-REPLACEMENTS"
      ],
      "description": "A fallback level may declare replacements.",
      "operation": "validate",
      "levels": [
        {
          "kind": "fallback",
          "declaration": {
            "schema_version": 2,
            "replacements": [
              {
                "term": "ostrevane",
                "reject": true
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "valid"
      }
    },
    {
      "id": "yaml-boolean-words-are-terms",
      "exercises": [
        "DECL-TERMS",
        "DECL-PHRASES"
      ],
      "description": "Words a YAML 1.1 reader would take as booleans are ordinary terms and phrases.",
      "operation": "validate",
      "levels": [
        {
          "kind": "directory",
          "declaration": {
            "schema_version": 2,
            "terms": [
              "yes",
              "no",
              "on",
              "off"
            ],
            "phrases": [
              "yes",
              "no"
            ]
          }
        }
      ],
      "expect": {
        "outcome": "valid"
      }
    },
    {
      "id": "phrases-one-once-folded-kept-once",
      "exercises": [
        "DECL-PHRASES"
      ],
      "description": "Phrases that are one once normalized and folded are kept once, the first as written: the second spelling adds nothing.",
      "operation": "detect",
      "levels": [
        {
          "kind": "fallback",
          "declaration": {
            "schema_version": 2,
            "phrases": [
              "Box-AB",
              "box-ab",
              "\uff42ox-ab"
            ]
          }
        }
      ],
      "rules": [
        {
          "term": "ab",
          "mode": "whole-word",
          "case_sensitive": false
        }
      ],
      "text": "ran on box-ab",
      "expect": {
        "outcome": "clean",
        "exempted": 1
      }
    },
    {
      "id": "unknown-member",
      "exercises": [
        "DECL-VERSION",
        "DECL-INVALID"
      ],
      "description": "A member the model does not define refuses the declaration.",
      "operation": "validate",
      "levels": [
        {
          "kind": "repository",
          "declaration": {
            "schema_version": 1,
            "extra": [
              "quillmoss"
            ]
          }
        }
      ],
      "expect": {
        "outcome": "declaration-error",
        "error": "unknown-member"
      }
    },
    {
      "id": "unknown-member-in-exception",
      "exercises": [
        "DECL-EXCEPTIONS",
        "DECL-INVALID"
      ],
      "description": "An exception entry carrying a member other than term and action is refused.",
      "operation": "validate",
      "levels": [
        {
          "kind": "repository",
          "declaration": {
            "schema_version": 1,
            "terms": [
              "quillmoss"
            ],
            "exceptions": [
              {
                "term": "quillmoss",
                "action": "drop",
                "why": "x"
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "declaration-error",
        "error": "unknown-member"
      }
    },
    {
      "id": "unknown-member-in-replacement",
      "exercises": [
        "DECL-REPLACEMENTS",
        "DECL-INVALID"
      ],
      "description": "A replacement entry carrying a member other than term, with and reject is refused.",
      "operation": "validate",
      "levels": [
        {
          "kind": "directory",
          "declaration": {
            "schema_version": 2,
            "replacements": [
              {
                "term": "quillmoss",
                "with": "example",
                "also": "x"
              }
            ]
          }
        }
      ],
      "expect": {
        "outcome": "declaration-error",
        "error": "unknown-member"
      }
    },
    {
      "id": "version-missing",
