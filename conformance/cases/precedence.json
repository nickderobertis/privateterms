{
  "description": "Layered declarations and precedence (Specification 1).",
  "cases": [
    {
      "id": "default-is-reject",
      "exercises": [
        "LEVEL-PRECEDENCE",
        "OUT-REJECT"
      ],
      "description": "A term no source resolves is rejected.",
      "operation": "resolve",
      "levels": [],
      "rules": [
        {
          "term": "quillmoss",
          "mode": "whole-word",
          "case_sensitive": false
        }
      ],
      "expect": {
        "outcome": "resolved",
        "rules": [
          {
            "term": "quillmoss",
            "mode": "whole-word",
            "case_sensitive": false,
            "action": "reject"
          }
        ]
      }
    },
    {
      "id": "level-terms-added-whole-word",
      "exercises": [
        "DECL-TERMS",
        "LEVEL-ORDER"
      ],
      "description": "Every level's terms add whole-word, not case-sensitive rules, nearest first after the repository's own.",
      "operation": "resolve",
      "levels": [
        {
          "kind": "repository",
          "declaration": {
            "schema_version": 1,
            "terms": [
              "vantorel"
            ]
          }
        },
        {
          "kind": "directory",
          "declaration": {
            "schema_version": 1,
            "terms": [
              "ostrevane"
            ]
          }
        },
        {
          "kind": "fallback",
          "declaration": {
            "schema_version": 1,
            "terms": [
              "pellucine"
            ]
          }
        }
      ],
      "rules": [
        {
          "term": "quillmoss",
          "mode": "substring",
          "case_sensitive": false
        }
      ],
      "expect": {
        "outcome": "resolved",
        "rules": [
          {
            "term": "quillmoss",
            "mode": "substring",
            "case_sensitive": false,
            "action": "reject"
          },
          {
            "term": "vantorel",
            "mode": "whole-word",
            "case_sensitive": false,
            "action": "reject"
          },
          {
            "term": "ostrevane",
            "mode": "whole-word",
            "case_sensitive": false,
            "action": "reject"
          },
          {
            "term": "pellucine",
            "mode": "whole-word",
            "case_sensitive": false,
            "action": "reject"
          }
        ]
      }
    },
    {
      "id": "replacement-names-new-term",
      "exercises": [
        "DECL-REPLACEMENTS"
      ],
      "description": "A replacement entry naming a term no rule carries adds it as a whole-word term.",
      "operation": "resolve",
      "levels": [
        {
          "kind": "directory",
          "declaration": {
            "schema_version": 2,
            "replacements": [
              {
                "term": "vantorel",
                "with": "sample"
              }
            ]
          }
        }
      ],
      "rules": [
        {
          "term": "quillmoss",
          "mode": "whole-word",
          "case_sensitive": false
        }
      ],
      "expect": {
        "outcome": "resolved",
        "rules": [
          {
            "term": "quillmoss",
            "mode": "whole-word",
            "case_sensitive": false,
            "action": "reject"
          },
          {
            "term": "vantorel",
            "mode": "whole-word",
            "case_sensitive": false,
            "action": {
              "replace": "sample"
            }
          }
        ]
      }
    },
